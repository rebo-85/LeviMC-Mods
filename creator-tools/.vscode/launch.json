{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug Creator Tools: Attach Minecraft",
      "type": "cppvsdbg",
      "request": "attach",
      "processId": "${command:pickProcess}",
      "symbolSearchPath": "${workspaceFolder}\\build\\windows\\x64\\debug;${workspaceFolder}\\bin\\creator-tools",
      "sourceFileMap": {
        "${workspaceFolder}": "${workspaceFolder}"
      },
      "preLaunchTask": "Build Creator Tools (debug)"
    }
  ]
}
