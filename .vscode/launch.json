{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug dev-client: Attach Minecraft",
      "type": "cppvsdbg",
      "request": "attach",
      "processId": "${command:pickProcess}",
      "symbolSearchPath": "${workspaceFolder}\\build\\windows\\x64\\debug;${workspaceFolder}\\bin\\dev-client",
      "sourceFileMap": {
        "${workspaceFolder}": "${workspaceFolder}"
      },
      "preLaunchTask": "Build dev-client (debug)"
    }
  ]
}
